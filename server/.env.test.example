NODE_ENV=test
PORT=5012
CLIENT_URL=http://localhost:3100
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/image_validator_test?schema=public

# db index 1 (NOT 0): tests call redis.flushdb(), which would otherwise wipe the
# dev database — destroying live refresh tokens and queue state.
REDIS_URL=redis://localhost:6381/1
ACCESS_TOKEN_SECRET=test-access-token-secret-32-chars-long
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=test-refresh-token-secret-32-chars-long
REFRESH_TOKEN_EXPIRY=7d
LOG_LEVEL=error

# Fake ImageKit creds so the upload-auth endpoint is exercised in tests.
IMAGEKIT_PUBLIC_KEY=public_test_key
IMAGEKIT_PRIVATE_KEY=private_test_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/testimage_validator

# Stops a stray dev worker consuming jobs a test just enqueued.
BULLMQ_PREFIX=bull-test
